// =============================================================================
// Oliver Velez - First 20 Minutes + 9 EMA Strategy (v5 - Clean)
// =============================================================================
//
// SIGNAL 1 — VELEZ OPEN (first 20 min):
//   Narrow state (20 SMA ≈ 200 SMA) + power bar above/below MAs
//   Enter on Bar 2 breakout, stop under Bar 1
//
// SIGNAL 2 — 9 EMA (all day):
//   BUY when candle closes above 9 EMA
//   SELL when candle closes below 9 EMA
//   Exit when candle crosses back through 9 EMA
//
// TIMEFRAME: 2-MINUTE chart
// =============================================================================
//@version=5
strategy("Velez + 9 EMA v5",
     overlay=true,
     initial_capital=50000,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=50,
     commission_type=strategy.commission.cash_per_order,
     commission_value=1.0,
     slippage=1,
     process_orders_on_close=false,
     calc_on_every_tick=false)
// =============================================================================
// INPUTS
// =============================================================================
grp_time = "⏰ Session & Timing"
sessionStart    = input.session("0930-0950", "Velez Window (ET)", group=grp_time)
mktHours        = input.session("0930-1550", "Market Hours (ET)", group=grp_time)
closeTime       = input.session("1550-1600", "Force Close Window", group=grp_time)
grp_ma = "📊 Moving Averages"
maShortLen   = input.int(20, "Short SMA Length", minval=5, maxval=50, group=grp_ma)
maLongLen    = input.int(200, "Long SMA Length", minval=50, maxval=500, group=grp_ma)
narrowThresh = input.float(0.3, "Narrow State Threshold (%)", minval=0.05, maxval=2.0, step=0.05, group=grp_ma)
emaLen       = input.int(9, "EMA Length", minval=3, maxval=50, group=grp_ma)
grp_bars = "🐘 Power Bar Detection"
elephantMult = input.float(1.5, "Elephant Bar Multiplier", minval=1.1, maxval=3.0, step=0.1, group=grp_bars)
tailRatio    = input.float(0.5, "Tail Bar Wick Ratio", minval=0.3, maxval=0.8, step=0.05, group=grp_bars)
lookbackBars = input.int(20, "Bar Size Lookback", minval=5, maxval=50, group=grp_bars)
grp_signals = "📡 Signal Selection"
useVelezOpen = input.bool(true, "Enable Velez Open Signal", group=grp_signals,
     tooltip="Original strategy: narrow state + power bar in first 20 minutes")
useEMASignal = input.bool(true, "Enable 9 EMA Signal", group=grp_signals,
     tooltip="Buy on candle close above 9 EMA, sell on close below. Exit on cross back.")
emaOnlyInMarket = input.bool(true, "9 EMA Only During Market Hours", group=grp_signals)
grp_trade = "💰 Trade Settings"
entryOffset    = input.float(0.01, "Entry Offset ($)", minval=0.01, maxval=0.50, step=0.01, group=grp_trade)
velezStopBar1  = input.bool(true, "Velez: Stop Under Bar 1", group=grp_trade)
useTrailingStop = input.bool(true, "Enable Fat Bar Trailing Stop", group=grp_trade)
useColorStop   = input.bool(true, "Enable Color Stop", group=grp_trade)
usePushExit    = input.bool(true, "Enable 3-Push Exit", group=grp_trade)
grp_visual = "🎨 Visuals"
showMAs      = input.bool(true, "Show 20/200 SMAs", group=grp_visual)
showEMA      = input.bool(true, "Show 9 EMA", group=grp_visual)
showSignals  = input.bool(true, "Show Entry/Exit Signals", group=grp_visual)
// =============================================================================
// TIME
// =============================================================================
inOpenWindow  = not na(time(timeframe.period, sessionStart, "America/New_York"))
inMarketHours = not na(time(timeframe.period, mktHours, "America/New_York"))
inCloseWindow = not na(time(timeframe.period, closeTime, "America/New_York"))
isNewDay      = ta.change(time("D")) != 0
var bool firstBarComplete = false
var int  barsInSession = 0
if isNewDay
    firstBarComplete := false
    barsInSession := 0
if inOpenWindow
    barsInSession += 1
    if barsInSession >= 2
        firstBarComplete := true
// =============================================================================
// MOVING AVERAGES
// =============================================================================
maShort = ta.sma(close, maShortLen)
maLong  = ta.sma(close, maLongLen)
ema9    = ta.ema(close, emaLen)
plot(showMAs ? maShort : na, "20 SMA", color=color.new(color.blue, 0), linewidth=2)
plot(showMAs ? maLong : na, "200 SMA", color=color.new(color.orange, 0), linewidth=2)
plot(showEMA ? ema9 : na, "9 EMA", color=color.new(#FFD600, 0), linewidth=2)
// =============================================================================
// STATE DETECTION
// =============================================================================
maDistancePct = math.abs(maShort - maLong) / maLong * 100
isNarrow = maDistancePct <= narrowThresh
aboveMAs = close > maShort and close > maLong
belowMAs = close < maShort and close < maLong
// =============================================================================
// BAR CLASSIFICATION
// =============================================================================
barRange    = high - low
bodySize    = math.abs(close - open)
avgBarRange = ta.sma(barRange, lookbackBars)
isGreen     = close > open
isRed       = close < open
isDoji      = close == open
lowerWick = math.min(open, close) - low
upperWick = high - math.max(open, close)
isElephantGreen = isGreen and bodySize > (avgBarRange * elephantMult) and barRange > 0 and (bodySize / barRange) > 0.6
isElephantRed   = isRed and bodySize > (avgBarRange * elephantMult) and barRange > 0 and (bodySize / barRange) > 0.6
isBottomingTail = barRange > 0 and (lowerWick / barRange) >= tailRatio and bodySize < barRange * 0.4
isToppingTail   = barRange > 0 and (upperWick / barRange) >= tailRatio and bodySize < barRange * 0.4
bullishPowerBar = isElephantGreen or isBottomingTail
bearishPowerBar = isElephantRed or isToppingTail
isFatGreen = isGreen and bodySize > (avgBarRange * 1.2)
isFatRed   = isRed and bodySize > (avgBarRange * 1.2)
// =============================================================================
// FIRST BAR TRACKING (Velez open)
// =============================================================================
var float firstBarHigh = na
var float firstBarLow  = na
var bool  fb_bullish = false
var bool  fb_bearish = false
if isNewDay
    firstBarHigh := na
    firstBarLow := na
    fb_bullish := false
    fb_bearish := false
if inOpenWindow and barsInSession == 1
    firstBarHigh := high
    firstBarLow  := low
    fb_bullish := isNarrow and aboveMAs and (isGreen or bullishPowerBar)
    fb_bearish := isNarrow and belowMAs and (isRed or bearishPowerBar)
// =============================================================================
// TRADE STATE
// =============================================================================
var bool  longActive   = false
var bool  shortActive  = false
var int   tradeSource  = 0        // 1 = velez, 2 = ema
var float initialStop  = na
var float trailStop    = na
var int   pushCount    = 0
var float lastPushHigh = na
var float lastPushLow  = na
var bool  addTriggered = false
if isNewDay
    longActive   := false
    shortActive  := false
    tradeSource  := 0
    initialStop  := na
    trailStop    := na
    pushCount    := 0
    lastPushHigh := na
    lastPushLow  := na
    addTriggered := false
noPosition = not longActive and not shortActive
// =============================================================================
// SIGNAL 1 — VELEZ OPEN ENTRY
// =============================================================================
velezLong = useVelezOpen and inOpenWindow and firstBarComplete and noPosition
     and fb_bullish and high > (firstBarHigh + entryOffset)
if velezLong
    longActive := true
    tradeSource := 1
    initialStop := firstBarLow - entryOffset
    trailStop := initialStop
    pushCount := 1
    lastPushHigh := high
    addTriggered := false
    strategy.entry("Buy", strategy.long)
    if velezStopBar1
        strategy.exit("Stop", "Buy", stop=initialStop)
velezShort = useVelezOpen and inOpenWindow and firstBarComplete and noPosition
     and fb_bearish and low < (firstBarLow - entryOffset)
if velezShort
    shortActive := true
    tradeSource := 1
    initialStop := firstBarHigh + entryOffset
    trailStop := initialStop
    pushCount := 1
    lastPushLow := low
    addTriggered := false
    strategy.entry("Sell", strategy.short)
    if velezStopBar1
        strategy.exit("Stop", "Sell", stop=initialStop)
// =============================================================================
// SIGNAL 2 — 9 EMA ENTRY
// =============================================================================
emaTimeOk = emaOnlyInMarket ? inMarketHours : true
// Candle closes above 9 EMA → Buy
// Must have been below or at EMA on previous bar for a fresh signal
emaCrossUp   = close > ema9 and close[1] <= ema9[1]
emaCrossDown = close < ema9 and close[1] >= ema9[1]
emaLong = useEMASignal and emaTimeOk and noPosition and emaCrossUp
if emaLong
    longActive := true
    tradeSource := 2
    initialStop := low - entryOffset
    trailStop := initialStop
    pushCount := 1
    lastPushHigh := high
    addTriggered := false
    strategy.entry("EMA Buy", strategy.long)
    strategy.exit("EMA Stop", "EMA Buy", stop=initialStop)
emaShort = useEMASignal and emaTimeOk and noPosition and emaCrossDown
if emaShort
    shortActive := true
    tradeSource := 2
    initialStop := high + entryOffset
    trailStop := initialStop
    pushCount := 1
    lastPushLow := low
    addTriggered := false
    strategy.entry("EMA Sell", strategy.short)
    strategy.exit("EMA Stop", "EMA Sell", stop=initialStop)
// =============================================================================
// 9 EMA EXIT — candle crosses back through EMA
// =============================================================================
var bool emaCrossExit = false
emaCrossExit := false
// Long: exit when candle closes below 9 EMA
if longActive and tradeSource == 2 and strategy.position_size > 0
    if close < ema9
        emaCrossExit := true
        strategy.close_all(comment="EMA Cross Exit")
        longActive := false
        pushCount := 0
// Short: exit when candle closes above 9 EMA
if shortActive and tradeSource == 2 and strategy.position_size < 0
    if close > ema9
        emaCrossExit := true
        strategy.close_all(comment="EMA Cross Exit")
        shortActive := false
        pushCount := 0
// =============================================================================
// VELEZ EXITS — trailing stop, color stop, 3-push (only for velez trades)
// =============================================================================
// --- Color Game Add (velez trades only) ---
var bool  sawOppBar = false
var float oppBarHigh = na
var float oppBarLow  = na
if isNewDay
    sawOppBar := false
    oppBarHigh := na
    oppBarLow := na
if longActive and tradeSource == 1 and strategy.position_size > 0 and not addTriggered
    if isRed and not sawOppBar
        sawOppBar := true
        oppBarHigh := high
    if sawOppBar and isGreen and high > oppBarHigh + entryOffset
        addTriggered := true
        strategy.entry("Add", strategy.long)
if shortActive and tradeSource == 1 and strategy.position_size < 0 and not addTriggered
    if isGreen and not sawOppBar
        sawOppBar := true
        oppBarLow := low
    if sawOppBar and isRed and low < oppBarLow - entryOffset
        addTriggered := true
        strategy.entry("Add", strategy.short)
// --- Fat Bar Trailing Stop ---
if longActive and strategy.position_size > 0 and useTrailingStop
    if isFatGreen
        newStop = low - entryOffset
        if newStop > trailStop
            trailStop := newStop
            strategy.exit("Trail", "Buy", stop=trailStop)
            strategy.exit("Trail A", "Add", stop=trailStop)
            strategy.exit("Trail E", "EMA Buy", stop=trailStop)
if shortActive and strategy.position_size < 0 and useTrailingStop
    if isFatRed
        newStop = high + entryOffset
        if newStop < trailStop
            trailStop := newStop
            strategy.exit("Trail", "Sell", stop=trailStop)
            strategy.exit("Trail A", "Add", stop=trailStop)
            strategy.exit("Trail E", "EMA Sell", stop=trailStop)
// --- Color Stop ---
if longActive and strategy.position_size > 0 and useColorStop
    if isGreen and isGreen[1] and isRed[2]
        cs = low[2] - entryOffset
        if cs > trailStop
            trailStop := cs
            strategy.exit("CStop", "Buy", stop=trailStop)
            strategy.exit("CStop A", "Add", stop=trailStop)
            strategy.exit("CStop E", "EMA Buy", stop=trailStop)
if shortActive and strategy.position_size < 0 and useColorStop
    if isRed and isRed[1] and isGreen[2]
        cs = high[2] + entryOffset
        if cs < trailStop
            trailStop := cs
            strategy.exit("CStop", "Sell", stop=trailStop)
            strategy.exit("CStop A", "Add", stop=trailStop)
            strategy.exit("CStop E", "EMA Sell", stop=trailStop)
// --- 3-Push Exit ---
var bool push3Exit = false
push3Exit := false
if longActive and strategy.position_size > 0 and usePushExit
    if high > lastPushHigh and isGreen and (isRed[1] or isRed[2] or isDoji[1])
        pushCount += 1
        lastPushHigh := high
    if pushCount >= 3
        push3Exit := true
        strategy.close_all(comment="3-Push")
        longActive := false
        pushCount := 0
if shortActive and strategy.position_size < 0 and usePushExit
    if low < lastPushLow and isRed and (isGreen[1] or isGreen[2] or isDoji[1])
        pushCount += 1
        lastPushLow := low
    if pushCount >= 3
        push3Exit := true
        strategy.close_all(comment="3-Push")
        shortActive := false
        pushCount := 0
// =============================================================================
// EOD CLOSE
// =============================================================================
var bool eodExit = false
eodExit := false
if inCloseWindow and strategy.position_size != 0
    eodExit := true
    strategy.close_all(comment="EOD")
    longActive  := false
    shortActive := false
    pushCount   := 0
// =============================================================================
// DETECT STOP HITS
// =============================================================================
var bool stopHit = false
stopHit := false
if longActive and strategy.position_size == 0 and not push3Exit and not emaCrossExit and not eodExit
    stopHit := true
    longActive := false
    pushCount := 0
if shortActive and strategy.position_size == 0 and not push3Exit and not emaCrossExit and not eodExit
    stopHit := true
    shortActive := false
    pushCount := 0
// =============================================================================
// VISUALS — CLEAN & MINIMAL
// =============================================================================
// --- Entry signals ---
// Velez entries: green/red labels
plotshape(showSignals and velezLong, "Velez Buy", shape.labelup, location.belowbar,
     color.new(#00C853, 0), text="BUY", textcolor=color.white, size=size.small)
plotshape(showSignals and velezShort, "Velez Sell", shape.labeldown, location.abovebar,
     color.new(#FF1744, 0), text="SELL", textcolor=color.white, size=size.small)
// EMA entries: gold labels
plotshape(showSignals and emaLong, "EMA Buy", shape.labelup, location.belowbar,
     color.new(#FFD600, 0), text="EMA↑", textcolor=color.black, size=size.small)
plotshape(showSignals and emaShort, "EMA Sell", shape.labeldown, location.abovebar,
     color.new(#FF6D00, 0), text="EMA↓", textcolor=color.white, size=size.small)
// --- Exit signals ---
plotshape(showSignals and emaCrossExit, "EMA Exit", shape.xcross, location.abovebar,
     color.new(#FFD600, 0), size=size.small, text="X", textcolor=color.black)
plotshape(showSignals and push3Exit, "3-Push", shape.xcross, location.abovebar,
     color.new(#FF9800, 0), size=size.small, text="3P", textcolor=color.white)
plotshape(showSignals and stopHit, "Stop", shape.xcross, location.belowbar,
     color.new(color.red, 0), size=size.small, text="STP", textcolor=color.white)
plotshape(showSignals and eodExit, "EOD", shape.xcross, location.abovebar,
     color.new(color.gray, 0), size=size.small, text="EOD", textcolor=color.white)
// --- Add signal ---
plotshape(showSignals and addTriggered and longActive and sawOppBar,
     "Add Long", shape.triangleup, location.belowbar, color.new(color.blue, 0), size=size.tiny, text="ADD")
plotshape(showSignals and addTriggered and shortActive and sawOppBar,
     "Add Short", shape.triangledown, location.abovebar, color.new(color.purple, 0), size=size.tiny, text="ADD")
// --- Trailing stop line ---
plot(longActive and strategy.position_size > 0 ? trailStop : na, "Long Trail",
     color=color.new(color.red, 30), style=plot.style_steplinebr, linewidth=2)
plot(shortActive and strategy.position_size < 0 ? trailStop : na, "Short Trail",
     color=color.new(color.green, 30), style=plot.style_steplinebr, linewidth=2)
// =============================================================================
// INFO TABLE (compact)
// =============================================================================
var table info = table.new(position.top_right, 2, 7, bgcolor=color.new(color.black, 80),
     border_width=1, border_color=color.gray)
if barstate.islast
    stateText  = isNarrow ? "NARROW" : "WIDE/TRANS"
    tradeText  = longActive ? "LONG" : shortActive ? "SHORT" : "FLAT"
    srcText    = tradeSource == 1 ? "Velez" : tradeSource == 2 ? "9 EMA" : "—"
    tradeColor = longActive ? color.lime : shortActive ? color.red : color.gray
    emaRelText = close > ema9 ? "Above 9 EMA" : close < ema9 ? "Below 9 EMA" : "At 9 EMA"

    table.cell(info, 0, 0, "State", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 0, stateText, text_color=isNarrow ? color.lime : color.orange, text_size=size.small)
    table.cell(info, 0, 1, "9 EMA", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 1, emaRelText, text_color=close > ema9 ? color.lime : color.red, text_size=size.small)
    table.cell(info, 0, 2, "Trade", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 2, tradeText, text_color=tradeColor, text_size=size.small)
    table.cell(info, 0, 3, "Source", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 3, srcText, text_color=color.white, text_size=size.small)
    table.cell(info, 0, 4, "Pushes", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 4, str.tostring(pushCount) + "/3", text_color=color.white, text_size=size.small)
    table.cell(info, 0, 5, "Stop", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 5, str.tostring(initialStop, "#.##"), text_color=color.red, text_size=size.small)
    table.cell(info, 0, 6, "Trail", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 6, str.tostring(trailStop, "#.##"), text_color=color.yellow, text_size=size.small)
// =============================================================================
// ALERTS
// =============================================================================
alertcondition(velezLong, "Velez Buy", "Velez: BUY signal")
alertcondition(velezShort, "Velez Sell", "Velez: SELL signal")
alertcondition(emaLong, "EMA Buy", "9 EMA: BUY signal — candle closed above EMA")
alertcondition(emaShort, "EMA Sell", "9 EMA: SELL signal — candle closed below EMA")
alertcondition(emaCrossExit, "EMA Exit", "9 EMA: Exit — candle crossed back")
alertcondition(push3Exit, "3-Push Exit", "3-Push exit triggered")
alertcondition(stopHit, "Stop Hit", "Stop loss hit")
